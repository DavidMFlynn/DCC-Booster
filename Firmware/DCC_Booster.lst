00291 0003 	; we loop through the interupt service routing every 0.01 seconds
00292 0003 	;
00293 0003 	;
00294 0003 		ORG	0x004	; interrupt vector location
00295 0004 018A 		CLRF	PCLATH
00296 0005 0188 		CLRF	BSR	; bank0
00297 0006 	;
00298 0006 	;
00299 0006 1C91 		BTFSS	PIR1,TMR2IF
00300 0007 282B 		goto	SystemTick_end
00301 0008 	;
00302 0008 1091 		BCF	PIR1,TMR2IF	; reset interupt flag bit
00303 0009 	;------------------
00304 0009 	; These routines run 100 times per second
00305 0009 	;
00306 0009 	;------------------
00307 0009 	;Decrement timers until they are zero
00308 0009 	;
00309 0009 2056 		call	DecTimer1	;if timer 1 is not zero decrement
00310 000A 2054 		call	DecTimer2
00311 000B 2052 		call	DecTimer3
00312 000C 2050 		call	DecTimer4
00313 000D 	;
00314 000D 	;-----------------------------------------------------------------
00315 000D 	; blink LEDs
00316 000D 	;
00317 000D 	; All LEDs off
00318 000D 0021 		movlb	0x01	;bank 1
00319 000E 178C 		bsf	SysLED_Tris
00320 000F 	;
00321 000F 	;
00322 000F 0020 		movlb	0x00	;bank 0
00323 0010 	;--------------------
00324 0010 	; Sys LED time
00325 0010 0BA3 		DECFSZ	SysLEDCount,F	;Is it time?
00326 0011 3208 		bra	SystemBlink_end	; No, not yet
00327 0012 	;
00328 0012 08A1 		movf	SysLED_Blinks,F
00329 0013 		SKPNZ		;Standard Blinking?
00329 0013 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00330 0014 3200 		bra	SystemBlink_Std	; Yes
00331 0015 	;
00332 0015 	; custom blinking
00333 0015 	;
00334 0015 01A2 	SystemBlink_Std	CLRF	SysLED_BlinkCount
00335 0016 0820 		MOVF	SysLED_Time,W
00336 0017 00A3 	SystemBlink_DoIt	MOVWF	SysLEDCount
00337 0018 0021 		movlb	0x01	;bank 1
00338 0019 138C 		bcf	SysLED_Tris	;LED ON
00339 001A 	SystemBlink_end:
00340 001A 	;--------------------
00341 001A 	; DCC Signal sensing
00342 001A 0020 	                       movlb                  0                      ;bank 0
00343 001B 1CAF 	                       btfss                  DCC_Sig1_Flag
00344 001C 112F 	                       bcf                    DCC_Sig2_Flag
00345 001D 10AF 	                       bcf                    DCC_Sig1_Flag
00346 001E 	; only change once per 0.01 sec
00347 001E 1D2F 	                       btfss                  DCC_Sig2_Flag
00348 001F 122F 	                       bcf                    DCC_Sig_Active
00349 0020 192F 	                       btfsc                  DCC_Sig2_Flag
00350 0021 162F 	                       bsf                    DCC_Sig_Active
00351 0022 	; set/clr DCC Sig OK LED
00352 0022 0103 	                       clrw
00353 0023 1A2F 	                       btfsc                  DCC_Sig_Active
00354 0024 1409 	                       bsf                    WREG,0
00355 0025 0022 	                       movlb                  2                      ;bank 2
00356 0026 1C09 	                       btfss                  WREG,0
00357 0027 120C 	                       bcf                    SigOK_LED
00358 0028 1809 	                       btfsc                  WREG,0
00359 0029 160C 	                       bsf                    SigOK_LED
00360 002A 0020 	                       movlb                  0                      ;bank 0
00361 002B 	;
00362 002B 	SystemTick_end:
00363 002B 	;
00364 002B 	;==================================================================================
00365 002B 	;
00366 002B 	; Handle CCP1 Interupt Flag, Enter w/ bank 0 selected
00367 002B 	;
00368 002B 0020 	IRQ_DCCSig	MOVLB	0	;bank 0
00369 002C 1D11 		BTFSS	PIR1,CCP1IF
00370 002D 3202 		bra	IRQ_DCCSig_End
00371 002E 	;
00372 002E 	;
00373 002E 0020 	IRQ_DCCSig_Done	MOVLB	0x00
00374 002F 1111 		BCF	PIR1,CCP1IF
00375 0030 	IRQ_DCCSig_End:
00376 0030 	;-----------------------------------------------------------------------------------------
00377 0030 0009 		retfie		; return from interrupt
00378 0031 	;
