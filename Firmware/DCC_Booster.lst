00174 0000 0021 		SysLED_Blinks		;0=1 flash,1,2,3
00175 0000 0022 		SysLED_BlinkCount
00176 0000 0023 		SysLEDCount		;sys LED Timer tick count
00177 0000 	;
00178 0000 0024 		EEAddrTemp		;EEProm address to read or write
00179 0000 0025 		EEDataTemp		;Data to be writen to EEProm
00180 0000 	;
