00020 0031 	;
00021 0031 	;=========================================================================================
00022 0031 	; Routines:
00023 0031 	;
00024 0031 	; ClearRam	(2+0) Clears all RAM, call once before initializing variables, FSR0
00025 0031 	; CopyToRam	(1+0) copy param memory (EEPROM) to ram, call once, FSR0
00026 0031 	; SaveParams	(1+0) copy ram to param memory (EEPROM), FSR0
00027 0031 	;
00028 0031 	;  Set FSR0H before calling these routines
00029 0031 	; DecTimer4	(0+0) Decrement routine for 16 bit timers, FSR0
00030 0031 	; DecTimer3
00031 0031 	; DecTimer2
00032 0031 	; DecTimer1
00033 0031 	; DecTimer	(0+0) High byte of counter address in W
00034 0031 	;
00035 0031 	; TestT4_Zero	Test for 16 bit timers = zero
00036 0031 	; TestT3_Zero	If Timer is zero return Z flag,1 else Z=0
00037 0031 	; TestT2_Zero
00038 0031 	; TestT1_Zero
00039 0031 	;
00040 0031 	; Delay10uS	(0+0)Delay uS    1 cycle = 1uS, 8Mhz clock version
00041 0031 	; Delay100uS
00042 0031 	; Delay40uS
00043 0031 	; DelayWuS
00044 0031 	;
00045 0031 	; EEReadW	(0+0) Read EEPROM address in W
00046 0031 	; EERead	(0+0) Read EEPROM address in EEAddrTemp
00047 0031 	; EEWriteW	(0+0) Write EEPROM address in W, Data in EEDataTemp
00048 0031 	; EEWrite	(0+0) Write EEPROM address in EEAdrTemp, Data in EEDataTemp, FSR0
00049 0031 	;
00050 0031 	;=========================================================================================
00051 0031 		ifndef UseEEParams
00053 0031 		endif
00054 0031 	;=========================================================================================
00055 0031 	; Clears all RAM
00056 0031 	; Entry: none
00057 0031 	; Exit: none
00058 0031 	; RAM used: All
00059 0031 	; Calls:(2+0) ClearRam_L2
00060 0031 	;
00061 0031 0020 	ClearRam	MOVLB	0x00
00062 0032 305F 		MOVLW	0x5F	;Clear 20h-7Eh, 95 bytes
00063 0033 00FF 		MOVWF	Param7F
00064 0034 3020 		MOVLW	0x20
00065 0035 0084 		MOVWF	FSR0
00066 0036 0185 		CLRF	FSR0H
00067 0037 204B 		CALL	ClearRam_L2
00068 0038 	;
00069 0038 3050 		MOVLW	0x50	;Clear A0h-EFh, 80 bytes
00070 0039 00FF 		MOVWF	Param7F
00071 003A 30A0 		MOVLW	0xA0
00072 003B 0084 		MOVWF	FSR0
