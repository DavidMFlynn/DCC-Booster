00291 0003 	; Interupt Service Routine
00292 0003 	;
00293 0003 	; we loop through the interupt service routing every 0.01 seconds
00294 0003 	;
00295 0003 	;
00296 0003 		ORG	0x004	; interrupt vector location
00297 0004 018A 		CLRF	PCLATH
00298 0005 0188 		CLRF	BSR	; bank0
00299 0006 	;
00300 0006 	;
00301 0006 1C91 		BTFSS	PIR1,TMR2IF
00302 0007 282D 		goto	SystemTick_end
00303 0008 	;
00304 0008 1091 		BCF	PIR1,TMR2IF	; reset interupt flag bit
00305 0009 	;------------------
00306 0009 	; These routines run 100 times per second
00307 0009 	;
00308 0009 	;------------------
00309 0009 	;Decrement timers until they are zero
00310 0009 	;
00311 0009 2058 		call	DecTimer1	;if timer 1 is not zero decrement
00312 000A 2056 		call	DecTimer2
00313 000B 2054 		call	DecTimer3
00314 000C 2052 		call	DecTimer4
00315 000D 	;
00316 000D 	;-----------------------------------------------------------------
00317 000D 	; blink LEDs
00318 000D 	;
00319 000D 	; All LEDs off
00320 000D 0021 		movlb	0x01	;bank 1
00321 000E 178C 		bsf	SysLED_Tris
00322 000F 	;
00323 000F 	;
00324 000F 0020 		movlb	0x00	;bank 0
00325 0010 	;--------------------
00326 0010 	; Sys LED time
00327 0010 0BA3 		DECFSZ	SysLEDCount,F	;Is it time?
00328 0011 3208 		bra	SystemBlink_end	; No, not yet
00329 0012 	;
00330 0012 08A1 		movf	SysLED_Blinks,F
00331 0013 		SKPNZ		;Standard Blinking?
00331 0013 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00332 0014 3200 		bra	SystemBlink_Std	; Yes
00333 0015 	;
00334 0015 	; custom blinking
00335 0015 	;
00336 0015 01A2 	SystemBlink_Std	CLRF	SysLED_BlinkCount
00337 0016 0820 		MOVF	SysLED_Time,W
00338 0017 00A3 	SystemBlink_DoIt	MOVWF	SysLEDCount
00339 0018 0021 		movlb	0x01	;bank 1
00340 0019 138C 		bcf	SysLED_Tris	;LED ON
00341 001A 	SystemBlink_end:
00342 001A 	;--------------------
00343 001A 	; DCC Signal sensing
00344 001A 0020 	                       movlb                  0                      ;bank 0
00345 001B 1CAF 	                       btfss                  DCC_Sig1_Flag
00346 001C 112F 	                       bcf                    DCC_Sig2_Flag
00347 001D 10AF 	                       bcf                    DCC_Sig1_Flag
00348 001E 	; only change once per 0.01 sec
00349 001E 1D2F 	                       btfss                  DCC_Sig2_Flag
00350 001F 122F 	                       bcf                    DCC_Sig_Active
00351 0020 192F 	                       btfsc                  DCC_Sig2_Flag
00352 0021 162F 	                       bsf                    DCC_Sig_Active
00353 0022 	; set/clr DCC Sig OK LED
00354 0022 0103 	                       clrw
00355 0023 1A2F 	                       btfsc                  DCC_Sig_Active
00356 0024 1409 	                       bsf                    WREG,0                 ;LED ON
00357 0025 1AB0 	                       btfsc                  DCC_Sig_Hold           ;But wait, still holding?
00358 0026 1009 	                       bcf                    WREG,0                 ; Yes, LED OFF
00359 0027 0022 	                       movlb                  2                      ;bank 2
00360 0028 1C09 	                       btfss                  WREG,0
00361 0029 120C 	                       bcf                    SigOK_LED
00362 002A 1809 	                       btfsc                  WREG,0
00363 002B 160C 	                       bsf                    SigOK_LED
00364 002C 0020 	                       movlb                  0                      ;bank 0
00365 002D 	;
00366 002D 	SystemTick_end:
00367 002D 	;
00368 002D 	;==================================================================================
00369 002D 	;
00370 002D 	; Handle CCP1 Interupt Flag, Enter w/ bank 0 selected
00371 002D 	;
00372 002D 0020 	IRQ_DCCSig	MOVLB	0	;bank 0
00373 002E 1D11 		BTFSS	PIR1,CCP1IF
00374 002F 3202 		bra	IRQ_DCCSig_End
00375 0030 	;
00376 0030 	;
00377 0030 0020 	IRQ_DCCSig_Done	MOVLB	0x00
00378 0031 1111 		BCF	PIR1,CCP1IF
00379 0032 	IRQ_DCCSig_End:
00380 0032 	;-----------------------------------------------------------------------------------------
00381 0032 0009 		retfie		; return from interrupt
00382 0033 	;
