00294 0000 	;
00295 0000 		ORG	0x000	; processor reset vector
00296 0000 018A 	ProgStartVector	CLRF	PCLATH
00297 0001 0188 	                       CLRF	BSR	; bank0
00298 0002 28A4 	  	goto	start	; go to beginning of program
00299 0003 	;
00300 0003 	;===============================================================================================
00301 0003 	; Interupt Service Routine
00302 0003 	;
00303 0003 	; we loop through the interupt service routing every 0.01 seconds
00304 0003 	;
00305 0003 	;
00306 0003 		ORG	0x004	; interrupt vector location
00307 0004 018A 		CLRF	PCLATH
00308 0005 0188 		CLRF	BSR	; bank0
00309 0006 	;
00310 0006 	;
00311 0006 1C91 		BTFSS	PIR1,TMR2IF
00312 0007 282D 		goto	SystemTick_end
00313 0008 	;
00314 0008 1091 		BCF	PIR1,TMR2IF	; reset interupt flag bit
00315 0009 	;------------------
00316 0009 	; These routines run 100 times per second
00317 0009 	;
00318 0009 	;------------------
00319 0009 	;Decrement timers until they are zero
00320 0009 	;
00321 0009 2058 		call	DecTimer1	;if timer 1 is not zero decrement
00322 000A 2056 		call	DecTimer2
00323 000B 2054 		call	DecTimer3
00324 000C 2052 		call	DecTimer4
00325 000D 	;
00326 000D 	;-----------------------------------------------------------------
00327 000D 	; blink LEDs
00328 000D 	;
00329 000D 	; All LEDs off
00330 000D 0021 		movlb	0x01	;bank 1
00331 000E 178C 		bsf	SysLED_Tris
00332 000F 	;
00333 000F 	;
00334 000F 0020 		movlb	0x00	;bank 0
00335 0010 	;--------------------
00336 0010 	; Sys LED time
00337 0010 0BA3 		DECFSZ	SysLEDCount,F	;Is it time?
00338 0011 3208 		bra	SystemBlink_end	; No, not yet
00339 0012 	;
00340 0012 08A1 		movf	SysLED_Blinks,F
00341 0013 		SKPNZ		;Standard Blinking?
00341 0013 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00342 0014 3200 		bra	SystemBlink_Std	; Yes
00343 0015 	;
00344 0015 	; custom blinking
00345 0015 	;
00346 0015 01A2 	SystemBlink_Std	CLRF	SysLED_BlinkCount
00347 0016 0820 		MOVF	SysLED_Time,W
00348 0017 00A3 	SystemBlink_DoIt	MOVWF	SysLEDCount
00349 0018 0021 		movlb	0x01	;bank 1
00350 0019 138C 		bcf	SysLED_Tris	;LED ON
00351 001A 	SystemBlink_end:
00352 001A 	;--------------------
00353 001A 	; DCC Signal sensing
00354 001A 0020 	                       movlb                  0                      ;bank 0
00355 001B 1CAF 	                       btfss                  DCC_Sig1_Flag
00356 001C 112F 	                       bcf                    DCC_Sig2_Flag
00357 001D 10AF 	                       bcf                    DCC_Sig1_Flag
00358 001E 	; only change once per 0.01 sec
00359 001E 1D2F 	                       btfss                  DCC_Sig2_Flag
00360 001F 122F 	                       bcf                    DCC_Sig_Active
00361 0020 192F 	                       btfsc                  DCC_Sig2_Flag
00362 0021 162F 	                       bsf                    DCC_Sig_Active
00363 0022 	; set/clr DCC Sig OK LED
00364 0022 0103 	                       clrw
00365 0023 1A2F 	                       btfsc                  DCC_Sig_Active
00366 0024 1409 	                       bsf                    WREG,0                 ;LED ON
00367 0025 1AB0 	                       btfsc                  DCC_Sig_Hold           ;But wait, still holding?
00368 0026 1009 	                       bcf                    WREG,0                 ; Yes, LED OFF
00369 0027 0022 	                       movlb                  2                      ;bank 2
00370 0028 1C09 	                       btfss                  WREG,0
00371 0029 120C 	                       bcf                    SigOK_LED
00372 002A 1809 	                       btfsc                  WREG,0
00373 002B 160C 	                       bsf                    SigOK_LED
00374 002C 0020 	                       movlb                  0                      ;bank 0
00375 002D 	;
00376 002D 	SystemTick_end:
00377 002D 	;
00378 002D 	;==================================================================================
00379 002D 	;
00380 002D 	; Handle CCP1 Interupt Flag, Enter w/ bank 0 selected
00381 002D 	;
00382 002D 0020 	IRQ_DCCSig	MOVLB	0	;bank 0
00383 002E 1D11 		BTFSS	PIR1,CCP1IF
00384 002F 3202 		bra	IRQ_DCCSig_End
00385 0030 	;
00386 0030 	;
00387 0030 0020 	IRQ_DCCSig_Done	MOVLB	0x00
00388 0031 1111 		BCF	PIR1,CCP1IF
00389 0032 	IRQ_DCCSig_End:
00390 0032 	;-----------------------------------------------------------------------------------------
00391 0032 0009 		retfie		; return from interrupt
00392 0033 	;
