00001 0033 	;=========================================================================================
00002 0033 	; Commonly used routines PIC16F1847 version
00003 0033 	;
00004 0033 	;    Filename:      F1847 Common.inc
00005 0033 	;    Date:          4/6/2019
00006 0033 	;    File Version:  1.0.2
00007 0033 	;
00008 0033 	;    Author:        David M. Flynn
00009 0033 	;    Company:       Oxford V.U.E., Inc.
00010 0033 	;    E-Mail:        dflynn@oxfordvue.com
00011 0033 	;    Web Site:      http://www.oxfordvue.com/
00012 0033 	;
00013 0033 	;=========================================================================================
00014 0033 	;    History:
00015 0033 	;
00016 0033 	; 1.0.2  4/6/2019	Fixes to EERead/EEwrite
00017 0033 	; 1.0.2 2/16/2019	Fix: added FSR0H to DecTimer.
00018 0033 	; 1.0.1 11/21/2015	Updates DecTimer.
00019 0033 	; 1.0   11/16/2013	Updated from F648A Common.inc
00020 0033 	;
00021 0033 	;=========================================================================================
00022 0033 	; Routines:
00023 0033 	;
00024 0033 	; ClearRam	(2+0) Clears all RAM, call once before initializing variables, FSR0
00025 0033 	; CopyToRam	(1+0) copy param memory (EEPROM) to ram, call once, FSR0
00026 0033 	; SaveParams	(1+0) copy ram to param memory (EEPROM), FSR0
00027 0033 	;
00028 0033 	;  Set FSR0H before calling these routines
00029 0033 	; DecTimer4	(0+0) Decrement routine for 16 bit timers, FSR0
00030 0033 	; DecTimer3
00031 0033 	; DecTimer2
00032 0033 	; DecTimer1
00033 0033 	; DecTimer	(0+0) High byte of counter address in W
00034 0033 	;
00035 0033 	; TestT4_Zero	Test for 16 bit timers = zero
00036 0033 	; TestT3_Zero	If Timer is zero return Z flag,1 else Z=0
00037 0033 	; TestT2_Zero
00038 0033 	; TestT1_Zero
00039 0033 	;
00040 0033 	; Delay10uS	(0+0)Delay uS    1 cycle = 1uS, 8Mhz clock version
00041 0033 	; Delay100uS
00042 0033 	; Delay40uS
00043 0033 	; DelayWuS
00044 0033 	;
00045 0033 	; EEReadW	(0+0) Read EEPROM address in W
00046 0033 	; EERead	(0+0) Read EEPROM address in EEAddrTemp
00047 0033 	; EEWriteW	(0+0) Write EEPROM address in W, Data in EEDataTemp
00048 0033 	; EEWrite	(0+0) Write EEPROM address in EEAdrTemp, Data in EEDataTemp, FSR0
00049 0033 	;
00050 0033 	;=========================================================================================
00051 0033 		ifndef UseEEParams
00053 0033 		endif
00054 0033 	;=========================================================================================
00055 0033 	; Clears all RAM
00056 0033 	; Entry: none
00057 0033 	; Exit: none
00058 0033 	; RAM used: All
00059 0033 	; Calls:(2+0) ClearRam_L2
00060 0033 	;
00061 0033 0020 	ClearRam	MOVLB	0x00
00062 0034 305F 		MOVLW	0x5F	;Clear 20h-7Eh, 95 bytes
00063 0035 00FF 		MOVWF	Param7F
00064 0036 3020 		MOVLW	0x20
00065 0037 0084 		MOVWF	FSR0
00066 0038 0185 		CLRF	FSR0H
