01164 0000 	;
00067 0000 		list
00068 0000 	;
00069 8007 EFA4 		__CONFIG _CONFIG1,_FOSC_INTOSC & _WDTE_OFF & _MCLRE_OFF & _IESO_OFF
00070 0000 	;
00071 0000 	;
00072 0000 	; INTOSC oscillator: I/O function on CLKIN pin
00073 0000 	; WDT disabled
00074 0000 	; PWRT disabled
00075 0000 	; MCLR/VPP pin function is digital input
00076 0000 	; Program memory code protection is disabled
00077 0000 	; Data memory code protection is disabled
00078 0000 	; Brown-out Reset enabled
00079 0000 	; CLKOUT function is disabled. I/O or oscillator function on the CLKOUT pin
00080 0000 	; Internal/External Switchover mode is disabled
00081 0000 	; Fail-Safe Clock Monitor is enabled
00082 0000 	;
00083 8008 DFFF 		__CONFIG _CONFIG2,_WRT_OFF & _PLLEN_ON & _LVP_OFF
00084 0000 	;
00085 0000 	; Write protection off
00086 0000 	; 4x PLL Enabled
00087 0000 	; Stack Overflow or Underflow will cause a Reset
00088 0000 	; Brown-out Reset Voltage (Vbor), low trip point selected.
00089 0000 	; Low-voltage programming enabled
00090 0000 	;
