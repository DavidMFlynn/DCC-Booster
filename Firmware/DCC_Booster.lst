00020 0033 	;
00021 0033 	;=========================================================================================
00022 0033 	; Routines:
00023 0033 	;
00024 0033 	; ClearRam	(2+0) Clears all RAM, call once before initializing variables, FSR0
00025 0033 	; CopyToRam	(1+0) copy param memory (EEPROM) to ram, call once, FSR0
00026 0033 	; SaveParams	(1+0) copy ram to param memory (EEPROM), FSR0
00027 0033 	;
00028 0033 	;  Set FSR0H before calling these routines
00029 0033 	; DecTimer4	(0+0) Decrement routine for 16 bit timers, FSR0
00030 0033 	; DecTimer3
00031 0033 	; DecTimer2
00032 0033 	; DecTimer1
00033 0033 	; DecTimer	(0+0) High byte of counter address in W
00034 0033 	;
00035 0033 	; TestT4_Zero	Test for 16 bit timers = zero
00036 0033 	; TestT3_Zero	If Timer is zero return Z flag,1 else Z=0
00037 0033 	; TestT2_Zero
00038 0033 	; TestT1_Zero
00039 0033 	;
00040 0033 	; Delay10uS	(0+0)Delay uS    1 cycle = 1uS, 8Mhz clock version
00041 0033 	; Delay100uS
00042 0033 	; Delay40uS
00043 0033 	; DelayWuS
00044 0033 	;
00045 0033 	; EEReadW	(0+0) Read EEPROM address in W
00046 0033 	; EERead	(0+0) Read EEPROM address in EEAddrTemp
00047 0033 	; EEWriteW	(0+0) Write EEPROM address in W, Data in EEDataTemp
00048 0033 	; EEWrite	(0+0) Write EEPROM address in EEAdrTemp, Data in EEDataTemp, FSR0
00049 0033 	;
00050 0033 	;=========================================================================================
