00291 0000 		ORG	0x000	; processor reset vector
00292 0000 018A 	ProgStartVector	CLRF	PCLATH
00293 0001 0188 	                       CLRF	BSR	; bank0
00294 0002 28A4 	  	goto	start	; go to beginning of program
00295 0003 	;
00296 0003 	;===============================================================================================
00297 0003 	; Interupt Service Routine
00298 0003 	;
00299 0003 	; we loop through the interupt service routing every 0.01 seconds
00300 0003 	;
00301 0003 	;
00302 0003 		ORG	0x004	; interrupt vector location
00303 0004 018A 		CLRF	PCLATH
00304 0005 0188 		CLRF	BSR	; bank0
00305 0006 	;
00306 0006 	;
00307 0006 1C91 		BTFSS	PIR1,TMR2IF
00308 0007 282D 		goto	SystemTick_end
00309 0008 	;
00310 0008 1091 		BCF	PIR1,TMR2IF	; reset interupt flag bit
00311 0009 	;------------------
00312 0009 	; These routines run 100 times per second
00313 0009 	;
00314 0009 	;------------------
00315 0009 	;Decrement timers until they are zero
00316 0009 	;
00317 0009 2058 		call	DecTimer1	;if timer 1 is not zero decrement
00318 000A 2056 		call	DecTimer2
00319 000B 2054 		call	DecTimer3
00320 000C 2052 		call	DecTimer4
00321 000D 	;
00322 000D 	;-----------------------------------------------------------------
00323 000D 	; blink LEDs
00324 000D 	;
00325 000D 	; All LEDs off
00326 000D 0021 		movlb	0x01	;bank 1
00327 000E 178C 		bsf	SysLED_Tris
00328 000F 	;
00329 000F 	;
00330 000F 0020 		movlb	0x00	;bank 0
00331 0010 	;--------------------
00332 0010 	; Sys LED time
00333 0010 0BA3 		DECFSZ	SysLEDCount,F	;Is it time?
00334 0011 3208 		bra	SystemBlink_end	; No, not yet
00335 0012 	;
00336 0012 08A1 		movf	SysLED_Blinks,F
00337 0013 		SKPNZ		;Standard Blinking?
00337 0013 1903      M		BTFSC	STATUS,Z		BTFSC	STATUS,Z
00338 0014 3200 		bra	SystemBlink_Std	; Yes
00339 0015 	;
00340 0015 	; custom blinking
00341 0015 	;
00342 0015 01A2 	SystemBlink_Std	CLRF	SysLED_BlinkCount
00343 0016 0820 		MOVF	SysLED_Time,W
00344 0017 00A3 	SystemBlink_DoIt	MOVWF	SysLEDCount
00345 0018 0021 		movlb	0x01	;bank 1
00346 0019 138C 		bcf	SysLED_Tris	;LED ON
00347 001A 	SystemBlink_end:
00348 001A 	;--------------------
00349 001A 	; DCC Signal sensing
00350 001A 0020 	                       movlb                  0                      ;bank 0
00351 001B 1CAF 	                       btfss                  DCC_Sig1_Flag
00352 001C 112F 	                       bcf                    DCC_Sig2_Flag
00353 001D 10AF 	                       bcf                    DCC_Sig1_Flag
00354 001E 	; only change once per 0.01 sec
00355 001E 1D2F 	                       btfss                  DCC_Sig2_Flag
00356 001F 122F 	                       bcf                    DCC_Sig_Active
00357 0020 192F 	                       btfsc                  DCC_Sig2_Flag
00358 0021 162F 	                       bsf                    DCC_Sig_Active
00359 0022 	; set/clr DCC Sig OK LED
00360 0022 0103 	                       clrw
00361 0023 1A2F 	                       btfsc                  DCC_Sig_Active
00362 0024 1409 	                       bsf                    WREG,0                 ;LED ON
00363 0025 1AB0 	                       btfsc                  DCC_Sig_Hold           ;But wait, still holding?
00364 0026 1009 	                       bcf                    WREG,0                 ; Yes, LED OFF
00365 0027 0022 	                       movlb                  2                      ;bank 2
00366 0028 1C09 	                       btfss                  WREG,0
00367 0029 120C 	                       bcf                    SigOK_LED
00368 002A 1809 	                       btfsc                  WREG,0
00369 002B 160C 	                       bsf                    SigOK_LED
00370 002C 0020 	                       movlb                  0                      ;bank 0
00371 002D 	;
00372 002D 	SystemTick_end:
00373 002D 	;
00374 002D 	;==================================================================================
00375 002D 	;
00376 002D 	; Handle CCP1 Interupt Flag, Enter w/ bank 0 selected
00377 002D 	;
00378 002D 0020 	IRQ_DCCSig	MOVLB	0	;bank 0
00379 002E 1D11 		BTFSS	PIR1,CCP1IF
00380 002F 3202 		bra	IRQ_DCCSig_End
00381 0030 	;
00382 0030 	;
00383 0030 0020 	IRQ_DCCSig_Done	MOVLB	0x00
00384 0031 1111 		BCF	PIR1,CCP1IF
00385 0032 	IRQ_DCCSig_End:
00386 0032 	;-----------------------------------------------------------------------------------------
00387 0032 0009 		retfie		; return from interrupt
00388 0033 	;
