01163 0000 		NOLIST
01164 0000 	;
00063 0000 		list
00064 0000 	;
00065 8007 EFA4 		__CONFIG _CONFIG1,_FOSC_INTOSC & _WDTE_OFF & _MCLRE_OFF & _IESO_OFF
00066 0000 	;
00067 0000 	;
00068 0000 	; INTOSC oscillator: I/O function on CLKIN pin
00069 0000 	; WDT disabled
00070 0000 	; PWRT disabled
00071 0000 	; MCLR/VPP pin function is digital input
00072 0000 	; Program memory code protection is disabled
00073 0000 	; Data memory code protection is disabled
00074 0000 	; Brown-out Reset enabled
00075 0000 	; CLKOUT function is disabled. I/O or oscillator function on the CLKOUT pin
00076 0000 	; Internal/External Switchover mode is disabled
00077 0000 	; Fail-Safe Clock Monitor is enabled
00078 0000 	;
00079 8008 DFFF 		__CONFIG _CONFIG2,_WRT_OFF & _PLLEN_ON & _LVP_OFF
00080 0000 	;
00081 0000 	; Write protection off
00082 0000 	; 4x PLL Enabled
00083 0000 	; Stack Overflow or Underflow will cause a Reset
00084 0000 	; Brown-out Reset Voltage (Vbor), low trip point selected.
00085 0000 	; Low-voltage programming enabled
00086 0000 	;
00087 0000 	; '__CONFIG' directive is used to embed configuration data within .asm file.
00088 0000 	; The lables following the directive are located in the respective .inc file.
00089 0000 	; See respective data sheet for additional information on configuration word.
00090 0000 	;
