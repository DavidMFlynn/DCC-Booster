00164 0000 	;***** VARIABLE DEFINITIONS
00165 0000 	; there is 1K bytes of ram, Bank0 0x20..0x7F, Bank1 0xA0..0xEF .. Bank11 0x620..0x66F
00166 0000 	; there are 256 bytes of EEPROM starting at 0x00 the EEPROM is not mapped into memory but
00167 0000 	;  accessed through the EEADR and EEDATA registers
00168 0000 	;================================================================================================
00169 0000 	;  Bank0 Ram 020h-06Fh 80 Bytes
00170 0000 	;
00171 0000 		cblock	0x20
