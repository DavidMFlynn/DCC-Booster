00182 0000 0027 		Timer1Hi		; 50 mS RX timeiout
00183 0000 0028 		Timer2Lo		;2nd 16 bit timer
00184 0000 0029 		Timer2Hi		; OverCurrentHold
00185 0000 002A 		Timer3Lo		;3rd 16 bit timer
00186 0000 002B 		Timer3Hi		; GP wait timer
00187 0000 002C 		Timer4Lo		;4th 16 bit timer
00188 0000 002D 		Timer4Hi		; debounce timer
